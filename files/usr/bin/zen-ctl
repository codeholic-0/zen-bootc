#!/bin/bash
# zen-ctl — upgrade check/status/apply/switch for zen-bootc; zen-dev bootstrap.
# Contract (verified 2026-11-10 on bootc-vm): no-update=empty+rc0;
# available=prose+rc0; unsigned ref=error+rc1. State: /var/lib/zen-ctl/last-check.
# Update size (bootc's "Total/Added/Removed layers ... Size:") is shown now.
set -u

STATE_DIR=/var/lib/zen-ctl
REPO=ghcr.io/codeholic-0/zen-bootc
SELF=$(readlink -f "$0")
ZEN_DEV_RAW=https://raw.githubusercontent.com/codeholic-0/zen-bootc/main/zen-dev
dig() { jq -r "$1" 2>/dev/null; }

# Self-elevate once: bare `zen-ctl …` prompts for sudo, root/cron pass through.
# Never called by cmd_zen_dev — that subcommand is strictly user-local.
for_sub() {
    [ "$(id -u)" -eq 0 ] || exec sudo -- "$SELF" "$@"
}
save_state() { mkdir -p "$STATE_DIR" && printf '%s\n' "$1" > "$STATE_DIR/last-check"; }

cmd_check() {
    for_sub check "$@"
    local out rc digest ver size added removed
    out=$(bootc upgrade --check 2>&1) && rc=0 || rc=$?
    if [ "$rc" -ne 0 ]; then
        save_state "$(date -Is) error $(printf '%s' "$out" | head -1)"
        logger -t zen-ctl "check failed (rc=$rc): $out"
        echo "zen-ctl: check failed (rc=$rc):" >&2
        printf '%s\n' "$out" >&2
        exit 2
    fi
    if [ -z "$out" ] || printf '%s' "$out" | grep -q '^No changes in:'; then
        save_state "$(date -Is) up-to-date"
        logger -t zen-ctl "check: up to date"
        echo "zen-ctl: up to date"
        return 0
    fi
    if printf '%s' "$out" | grep -q '^Update available for:'; then
        digest=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Digest: //p' | head -1)
        ver=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Version: //p' | head -1)
        size=$(printf '%s\n' "$out" | sed -n 's/^Total new layers:.*Size: //p' | head -1)
        added=$(printf '%s\n' "$out" | sed -n 's/^Added layers:.*Size: //p' | head -1)
        removed=$(printf '%s\n' "$out" | sed -n 's/^Removed layers:.*Size: //p' | head -1)
        save_state "$(date -Is) available ${digest:-?} ${ver:-?} ${size:-?}"
        logger -t zen-ctl "check: update available ${ver:-} ${digest:-} ${size:-}"
        echo "zen-ctl: update available ${ver:-(version unknown)} ${digest:-}"
        if [ -n "${size:-}" ]; then
            echo "          size: ${size}"
        fi
        if [ -n "${added:-}" ] || [ -n "${removed:-}" ]; then
            echo "          layers: +${added:-?} added / -${removed:-?} removed"
        fi
        # wall = cron channel only; interactive runs already show the lines
        # above (wall would re-broadcast into the same pts = duplicate).
        [ -t 0 ] || { echo "zen-ctl: update available ${size:+($size) }— run 'zen-ctl upgrade'" | wall 2>/dev/null || true; }
        return 1
    fi
    save_state "$(date -Is) unknown $(printf '%s' "$out" | head -1)"
    logger -t zen-ctl "check: unexpected output: $out"
    echo "zen-ctl: unexpected check output (see journal)" >&2
    printf '%s\n' "$out" >&2
    exit 2
}

cmd_status() {
    for_sub status "$@"
    local sj d1 v1 tag d2 out d3 v2 size
    local rollback_digest rollback_version rollback_tag
    sj=$(bootc status --json 2>/dev/null)
    d1=$(printf '%s' "$sj" | dig '.status.booted.image.imageDigest')
    v1=$(printf '%s' "$sj" | dig '.status.booted.image.version')
    tag=$(printf '%s' "$sj" | dig '.status.booted.image.image.image')
    d2=$(printf '%s' "$sj" | dig '.status.staged.image.imageDigest')
    rollback_digest=$(printf '%s' "$sj" | dig '.status.rollback.image.imageDigest')
    rollback_version=$(printf '%s' "$sj" | dig '.status.rollback.image.version')
    rollback_tag=$(printf '%s' "$sj" | dig '.status.rollback.image.image.image')

    echo "tracked:  ${tag:-unknown}"
    echo "running:  ${v1:-?} ${d1:-unknown}"
    if [ -n "$d2" ] && [ "$d2" != "null" ]; then
        echo "staged:   $d2"
    else
        echo "staged:   none"
    fi
    if [ -n "$rollback_digest" ] && [ "$rollback_digest" != "null" ]; then
        echo "rollback: ${rollback_tag:-unknown}"
        echo "          ${rollback_version:-?} ${rollback_digest}"
    else
        echo "rollback: none"
    fi

    out=$(bootc upgrade --check 2>/dev/null) || { echo "remote:  check failed"; return 2; }
    if [ -z "$out" ] || printf '%s' "$out" | grep -q '^No changes in:'; then
        echo "remote:  up to date"
        save_state "$(date -Is) up-to-date"
        return 0
    fi
    if ! printf '%s' "$out" | grep -q '^Update available for:'; then
        echo "remote:  unknown output"
        save_state "$(date -Is) unknown"
        return 2
    fi
    d3=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Digest: //p' | head -1)
    v2=$(printf '%s' "$out" | sed -n 's/^[[:space:]]*Version: //p' | head -1)
    size=$(printf '%s\n' "$out" | sed -n 's/^Total new layers:.*Size: //p' | head -1)
    echo "remote:  update available ${v2:-} ${d3:-}"
    [ -n "${size:-}" ] && echo "         size: ${size}"
    save_state "$(date -Is) available ${d3:-?} ${v2:-?} ${size:-?}"
    return 1
}

cmd_remove_rollback() {
    [ "$#" -eq 0 ] || { echo "usage: zen-ctl remove-rollback" >&2; return 2; }
    for_sub remove-rollback "$@"

    command -v ostree >/dev/null 2>&1 || {
        echo "zen-ctl: ostree is required" >&2
        return 1
    }
    command -v bootc >/dev/null 2>&1 || {
        echo "zen-ctl: bootc is required" >&2
        return 1
    }
    command -v jq >/dev/null 2>&1 || {
        echo "zen-ctl: jq is required" >&2
        return 1
    }

    local ostree_json bootc_json rollback_count rollback_json
    local rollback_index checksum bootc_checksum version image_ref image_digest
    local ans verify_ostree verify_bootc

    ostree_json=$(ostree admin status --json 2>&1) || {
        echo "zen-ctl: could not read OSTree deployment status:" >&2
        printf '%s\n' "$ostree_json" >&2
        return 1
    }
    bootc_json=$(bootc status --json 2>&1) || {
        echo "zen-ctl: could not read bootc status:" >&2
        printf '%s\n' "$bootc_json" >&2
        return 1
    }

    rollback_count=$(printf '%s' "$ostree_json" |
        jq '[.deployments[] | select(.rollback == true)] | length' 2>/dev/null) || {
        echo "zen-ctl: could not parse OSTree deployment status JSON" >&2
        return 1
    }

    if [ "$rollback_count" -eq 0 ]; then
        echo "zen-ctl: no rollback deployment found"
        return 0
    fi
    if [ "$rollback_count" -ne 1 ]; then
        echo "zen-ctl: expected one rollback deployment, found $rollback_count; refusing to remove anything" >&2
        return 1
    fi

    rollback_json=$(printf '%s' "$ostree_json" |
        jq -c '[.deployments[] | select(.rollback == true)][0]' 2>/dev/null) || {
        echo "zen-ctl: could not read rollback deployment details" >&2
        return 1
    }

    rollback_index=$(printf '%s' "$rollback_json" | jq -r '.index // empty')
    checksum=$(printf '%s' "$rollback_json" | jq -r '.checksum // empty')
    case "$rollback_index" in
        ''|*[!0-9]*)
            echo "zen-ctl: rollback deployment has an invalid index; refusing to remove anything" >&2
            return 1
            ;;
    esac
    if [ -z "$checksum" ]; then
        echo "zen-ctl: rollback deployment has no checksum; refusing to remove anything" >&2
        return 1
    fi

    bootc_checksum=$(printf '%s' "$bootc_json" |
        jq -r '.status.rollback.ostree.checksum // empty' 2>/dev/null) || bootc_checksum=""
    version=$(printf '%s' "$bootc_json" |
        jq -r '.status.rollback.image.version // "unknown"' 2>/dev/null) || version="unknown"
    image_ref=$(printf '%s' "$bootc_json" |
        jq -r '.status.rollback.image.image.image // "unknown"' 2>/dev/null) || image_ref="unknown"
    image_digest=$(printf '%s' "$bootc_json" |
        jq -r '.status.rollback.image.imageDigest // "unknown"' 2>/dev/null) || image_digest="unknown"

    if [ -n "$bootc_checksum" ] && [ "$bootc_checksum" != "$checksum" ]; then
        echo "zen-ctl: bootc and OSTree disagree about which deployment is rollback; refusing to remove anything" >&2
        echo "  bootc checksum:  $bootc_checksum" >&2
        echo "  OSTree checksum: $checksum" >&2
        return 1
    fi

    echo "Rollback deployment to remove:"
    echo "  index:    $rollback_index"
    echo "  image:    $image_ref"
    echo "  version:  $version"
    echo "  digest:   $image_digest"
    echo "  checksum: $checksum"
    echo
    echo "This permanently removes the rollback deployment. You will no longer"
    echo "be able to boot back into it."
    printf 'Remove this rollback deployment? [y/N] '
    read -r ans
    case "$ans" in
        [yY]|[yY][eE][sS]) ;;
        *) echo "zen-ctl: canceled"; return 0 ;;
    esac

    # Re-read both sources before acting: deployment indexes can change.
    # Require the same OSTree checksum at the same index, still marked rollback
    # and not booted. If bootc has an OSTree checksum, require it to match too.
    ostree_json=$(ostree admin status --json 2>&1) || {
        echo "zen-ctl: could not re-read OSTree deployment status:" >&2
        printf '%s\n' "$ostree_json" >&2
        return 1
    }
    verify_ostree=$(printf '%s' "$ostree_json" |
        jq -c --argjson idx "$rollback_index" --arg checksum "$checksum" \
            '.deployments[] | select(.index == $idx and .rollback == true and .booted != true and .checksum == $checksum)' \
            2>/dev/null) || verify_ostree=""
    if [ -z "$verify_ostree" ]; then
        echo "zen-ctl: rollback deployment changed since confirmation; refusing to remove anything" >&2
        return 1
    fi

    bootc_json=$(bootc status --json 2>&1) || {
        echo "zen-ctl: could not re-read bootc status:" >&2
        printf '%s\n' "$bootc_json" >&2
        return 1
    }
    verify_bootc=$(printf '%s' "$bootc_json" |
        jq -r '.status.rollback.ostree.checksum // empty' 2>/dev/null) || verify_bootc=""
    if [ -n "$verify_bootc" ] && [ "$verify_bootc" != "$checksum" ]; then
        echo "zen-ctl: bootc rollback deployment changed since confirmation; refusing to remove anything" >&2
        return 1
    fi

    if ! ostree admin undeploy "$rollback_index"; then
        echo "zen-ctl: failed to remove rollback deployment at index $rollback_index" >&2
        return 1
    fi

    logger -t zen-ctl "removed rollback deployment index=$rollback_index checksum=$checksum"
    echo "zen-ctl: rollback deployment removed"
}

cmd_upgrade() {
    for_sub upgrade "$@"
    if [ "${1:-}" = "--apply" ]; then
        exec bootc upgrade --apply
    elif [ "$#" -gt 0 ]; then
        echo "usage: zen-ctl upgrade [--apply]" >&2
        exit 2
    fi
    exec bootc upgrade
}

# --- switch: browse/roll to the single image's tags (manual, confirmed, policy-guarded) ---
tags_list() {   # dated anchors only, newest first (rolling tag shown separately)
    podman search --list-tags "$REPO" 2>/dev/null | awk '{print $2}' \
        | grep -E '^latest-[0-9]{8}-[0-9a-f]{7}$' | LC_ALL=C sort -r
}

switch_show() {   # read-only listing, no elevation assumed
    local f t tracked now dated
    tracked=$(bootc status --json 2>/dev/null | dig '.status.booted.image.image.image')
    [ "$tracked" = "null" ] && tracked=""
    dated=$(tags_list)
    for f in latest; do
        echo "$f:"
        printf '  %-30s%s\n' "$f" "$([ "$REPO:$f" = "$tracked" ] && echo '   <- current')"
        printf '%s\n' "$dated" | grep "^$f-" | head -4 | while read -r t; do
            now=""
            [ "$REPO:$t" = "$tracked" ] && now="   <- current"
            printf '  %-30s%s\n' "$t" "$now"
        done
    done
    echo "(rolling tags auto-updates; dated tags are pinned rollback anchors)"
}

cmd_switch() {
    if [ "${1:-}" = "--list" ]; then switch_show; return 0; fi
    for_sub switch "$@"
    local tag out ans
    if [ -n "${1:-}" ]; then
        tag=$1
    else
        switch_show
        printf 'tag to switch ("q"=cancel): '
        read -r tag
        case "${tag:-q}" in q|""|*[!a-zA-Z0-9._-]*) echo "zen-ctl: no tag selected"; return 0 ;; esac
    fi
    case "$tag" in
        latest) ;;
        *)
            tags_list | grep -qx "$tag" || { echo "zen-ctl: not a known latest tag: $tag" >&2; return 2; }
            ;;
    esac
    echo "== target probe: $REPO:$tag"
    out=$(bootc upgrade --tag "$tag" --check 2>&1) || {
        printf '%s\n' "$out" >&2
        echo "zen-ctl: probe failed (registry/signature?) — not switching" >&2
        return 2
    }
    [ -n "$out" ] && printf '%s\n' "$out"
    printf 'switch to %s:%s? [y/N] ' "$REPO" "$tag"
    read -r ans
    case "$ans" in [yY]*) ;; *) echo "zen-ctl: canceled"; return 0 ;; esac
    bootc switch --transport registry "$REPO:$tag" \
        && { logger -t zen-ctl "switch: -> $tag"; echo "zen-ctl: staged $tag — reboot to enter it"; }
}

# --- zen-dev: user-local bootstrap; never elevates, never writes to /usr ---
# Trust class matches `zen-dev update`: raw main over TLS, syntax/header
# checked, deliberately unsigned. The tool lives in $HOME and self-updates.
cmd_zen_dev() {
    [ "$#" -eq 0 ] || { echo "usage: zen-ctl zen-dev" >&2; return 2; }
    if [ "$(id -u)" -eq 0 ] || [ -n "${SUDO_USER:-}" ]; then
        echo "zen-ctl: zen-dev installs into the invoking user's HOME; run 'zen-ctl zen-dev' without sudo/root" >&2
        return 2
    fi
    command -v curl >/dev/null 2>&1 || { echo "zen-ctl: curl is required for zen-dev bootstrap" >&2; return 1; }

    local target tmp
    target="$HOME/.local/bin/zen-dev"
    mkdir -p "$(dirname "$target")" || { echo "zen-ctl: cannot create $(dirname "$target")" >&2; return 1; }

    tmp=$(mktemp "$(dirname "$target")/.zen-dev.XXXXXX") || {
        echo "zen-ctl: mktemp failed" >&2
        return 1
    }

    if ! curl --proto '=https' --proto-redir '=https' -fsSL "$ZEN_DEV_RAW" -o "$tmp"; then
        rm -f "$tmp"
        echo "zen-ctl: zen-dev fetch failed" >&2
        return 1
    fi
    if ! bash -n "$tmp" 2>/dev/null || ! grep -q '^# zen-dev' "$tmp"; then
        rm -f "$tmp"
        echo "zen-ctl: fetched zen-dev failed sanity checks — nothing installed" >&2
        return 1
    fi

    if ! chmod 0755 "$tmp"; then
        rm -f "$tmp"
        echo "zen-ctl: could not set installation permissions" >&2
        return 1
    fi

    if ! mv -f -- "$tmp" "$target"; then
        rm -f "$tmp"
        echo "zen-ctl: could not install $target" >&2
        return 1
    fi

    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) echo "zen-dev: note: $HOME/.local/bin is not in PATH" >&2 ;;
    esac
    echo "zen-dev installed at $target"
    echo "  zen-dev            list tools + install state"
    echo "  zen-dev update     self-update from the repo"
}

case "${1:-}" in
    check)           shift; cmd_check "$@" ;;
    status)          shift; cmd_status "$@" ;;
    remove-rollback) shift; cmd_remove_rollback "$@" ;;
    upgrade)         shift; cmd_upgrade "$@" ;;
    switch)          shift; cmd_switch "$@" ;;
    zen-dev)         shift; cmd_zen_dev "$@" ;;
    help|-h|--help|"")
        echo "usage: zen-ctl check | status | remove-rollback | upgrade [--apply] | switch [--list|<tag>] | zen-dev"
        echo "  check           probe upstream; shows download size; rc1 = update available"
        echo "  status          running/staged/rollback image details + live remote check"
        echo "  remove-rollback remove the non-booted rollback deployment permanently"
        echo "  upgrade         stage an update (never automatic); --apply reboots into it"
        echo "  switch          roll to :latest or a dated latest-YYYYMMDD-sha7 anchor"
        echo "                  (browse tags, probe target, explicit confirm; --list is"
        echo "                  read-only, no elevation)"
        echo "  zen-dev         install/refresh user-local zen-dev into ~/.local/bin"
        echo "                  (raw main, sanity-checked; never uses sudo or touches /usr)"
        echo "Sudo is prompted automatically for system commands; cron runs check as"
        echo "root weekly (Sat 22:00). zen-dev is unsigned user tooling by design." ;;
    *) echo "zen-ctl: unknown subcommand '$1'" >&2; exit 2 ;;
esac